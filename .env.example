# Freight Procurement Terminal — environment configuration
# Copy to .env (never commit .env) and set per environment.

# --- API access control -------------------------------------------------
# Comma-separated API keys. When set, every /api/* route except /api/health
# requires the X-API-Key header. Issue one key per customer/tenant.
API_KEYS=
# e.g. API_KEYS=tenant-a-9f2c,tenant-b-71ab

# Comma-separated browser origins allowed to call this API cross-origin
# (CORS allowlist). Leave empty for same-origin-only deployments.
CORS_ALLOWED_ORIGINS=
# e.g. CORS_ALLOWED_ORIGINS=https://terminal.yourdomain.com

# Requests per minute per key (or per IP when unauthenticated).
RATE_LIMIT_PER_MINUTE=120

# --- Server -------------------------------------------------------------
# Dev server (backend/run.py) binds here; defaults to 0.0.0.0 so PaaS
# deployments (Render/Railway/Fly) pass health checks. Set HOST=127.0.0.1
# for local development. Production uses gunicorn:
#   gunicorn -c backend/gunicorn.conf.py backend.run:app
PORT=5000
# HOST=127.0.0.1
# NEVER enable outside local development (debugger = remote code execution).
FLASK_DEBUG=

# --- Data posture -------------------------------------------------------
# 1 only for demo environments: allows clearly-labeled SYNTHETIC forecast
# data when the market dataset is unavailable. Never set in production.
DEMO_MODE=

# --- Frontend (Vite, frontend/.env) -------------------------------------
# Base URL of the API. Defaults to same-origin /api when unset.
# VITE_API_URL=https://api.yourdomain.com
